{
  "version": 4,
  "scope": "12 themes; 100 three-color combinations",
  "color_order": "Stored order has no implied color role or area ratio",
  "families": [
    {
      "id": "ocean-paper",
      "name": "Ocean Paper",
      "keywords": "calm, crisp, papery",
      "ids": "ocean-paper-01 … ocean-paper-09",
      "guidance": "Deep blues with cool whites and warm grays for reading interfaces, ocean illustrations, and posters."
    },
    {
      "id": "cream-sky",
      "name": "Cream Sky",
      "keywords": "bright, airy, soft",
      "ids": "cream-sky-01",
      "guidance": "Cream, light sky blue, and soft yellow for lifestyle interfaces and airy illustrations."
    },
    {
      "id": "berry-cocoa",
      "name": "Berry Cocoa",
      "keywords": "retro, sweet, warm",
      "ids": "berry-cocoa-01 … berry-cocoa-09",
      "guidance": "Berry reds with cream, cocoa brown, or teal for dessert packaging and retro posters."
    },
    {
      "id": "wood-mist",
      "name": "Wood Mist",
      "keywords": "natural, minimal, gentle",
      "ids": "wood-mist-01 … wood-mist-09",
      "guidance": "Off-white, wood tones, and pale cyan for interiors, content interfaces, and still life."
    },
    {
      "id": "moss-tea",
      "name": "Moss Tea",
      "keywords": "quiet, natural, earthy",
      "ids": "moss-tea-01 … moss-tea-09",
      "guidance": "Moss, olive, tea brown, and cream form layers; some combinations include red accents."
    },
    {
      "id": "sky-lilac",
      "name": "Sky Lilac",
      "keywords": "clear, serene, softly lit",
      "ids": "sky-lilac-01 … sky-lilac-09",
      "guidance": "Sky blue, lilac, and cloud white, sometimes with pale apricot, for sky and soft-light scenes."
    },
    {
      "id": "electric-pop",
      "name": "Electric Pop",
      "keywords": "bold, lively, energetic",
      "ids": "electric-pop-01 … electric-pop-09",
      "guidance": "Cyan, bright yellow, orange, and pink with deep blue-purple for event graphics and digital illustration."
    },
    {
      "id": "crimson-gold",
      "name": "Crimson Gold",
      "keywords": "rich, grounded, formal",
      "ids": "crimson-gold-01 … crimson-gold-09",
      "guidance": "Crimson, near-black, brass yellow, and deep purple for packaging and dark visual themes."
    },
    {
      "id": "vermilion-ink",
      "name": "Vermilion Ink",
      "keywords": "bold, strong, grounded",
      "ids": "vermilion-ink-01 … vermilion-ink-09",
      "guidance": "Vermilion with ink tones, teal, or deep blue; strong light-dark contrast separates layers."
    },
    {
      "id": "rain-slate",
      "name": "Rain Slate",
      "keywords": "cool, restrained, quiet",
      "ids": "rain-slate-01 … rain-slate-09",
      "guidance": "Misty blue, slate, ink, and icy white for rainy scenes and utility interfaces."
    },
    {
      "id": "citrus-sun",
      "name": "Citrus Sun",
      "keywords": "warm, positive, energetic",
      "ids": "citrus-sun-01 … citrus-sun-09",
      "guidance": "Orange, warm yellow, vermilion, and warm brown for food, sport, and event graphics."
    },
    {
      "id": "mint-candy",
      "name": "Mint Candy",
      "keywords": "soft, airy, sweet",
      "ids": "mint-candy-01 … mint-candy-09",
      "guidance": "Pale pink, light yellow, mint, and apricot for soft illustrations and decorative surfaces."
    }
  ],
